{
  "name": "dpmg",
  "version": "0.0.0",
  "private": true,
  "description": "DPMG - Application interne de gestion des demandes opérationnelles",
  "scripts": {
    "dev": "pnpm --filter @dpmg/api --filter @dpmg/web dev",
    "dev:api": "pnpm --filter @dpmg/api dev",
    "dev:web": "pnpm --filter @dpmg/web dev",
    "build": "pnpm --filter @dpmg/api --filter @dpmg/web build",
    "build:api": "pnpm --filter @dpmg/api build",
    "build:web": "pnpm --filter @dpmg/web build",
    "lint": "pnpm --filter @dpmg/api --filter @dpmg/web lint",
    "typecheck": "pnpm --filter @dpmg/api --filter @dpmg/web typecheck",
    "test": "pnpm --filter @dpmg/api test && pnpm --filter @dpmg/web test",
    "db:generate": "pnpm --filter @dpmg/api db:generate",
    "db:push": "pnpm --filter @dpmg/api db:push",
    "db:studio": "pnpm --filter @dpmg/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "5.22.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prisma": "5.22.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}