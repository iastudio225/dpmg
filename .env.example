# Environnement
NODE_ENV=development

# API
PORT=3001
FRONTEND_URL=http://localhost:5173

# Session (obligatoire en production)
# SESSION_SECRET=your-super-secret-session-key-min-32-chars
SESSION_MAX_AGE=86400000

# Limitation de taux pour la connexion
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# Justificatifs d'exécution (stockage local)
# UPLOAD_DIR=apps/api/uploads
PROOF_MAX_SIZE_MB=10

# Base de données (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/dpmg?schema=public