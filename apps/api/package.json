{
  "name": "@dpmg/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:test": "tsx watch src/dev-test.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/app.test.ts src/demandes.test.ts src/demandes-avis.test.ts src/demandes-validation.test.ts src/demandes-reference.test.ts src/demandes-visibilite.test.ts src/demandes-dpmg.test.ts src/users.test.ts src/structures.test.ts src/departments.test.ts src/demandes-dg-cpmp.test.ts src/consolidations.test.ts src/consolidation-observation.test.ts src/consolidation-observations-routes.test.ts src/dfc-consolidation.test.ts src/demandes-justificatif.test.ts src/notifications.test.ts src/notification-service.test.ts src/notification-worker.test.ts src/prestataires-devis.test.ts src/prestataires-devis-http.test.ts",
    "db:generate": "prisma generate --schema=../../database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=../../database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=../../database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=../../database/prisma/schema.prisma",
    "db:seed": "tsx src/scripts/seed-demo.ts",
    "db:seed:admin": "tsx src/scripts/create-admin.ts",
    "notifications:worker": "tsx src/worker/notifications.ts",
    "notifications:worker:test": "tsx src/worker/notifications-test.ts"
  },
  "dependencies": {
    "@dpmg/shared": "workspace:*",
    "@prisma/client": "^5.18.0",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.1",
    "prisma": "^5.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.14",
    "@types/pg": "^8.23.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}

